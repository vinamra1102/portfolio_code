{
  "permissions": {
    "allow": [
      "Shell(npx create-next-app@latest . --typescript --tailwind --eslint --app --src-dir --no-import-alias --use-npm)",
      "Shell(npx create-next-app@latest temp-nextjs --typescript --tailwind --eslint --app --src-dir --no-import-alias --use-npm)",
      "Shell(powershell -Command Get-ChildItem -Path temp-nextjs -Force)",
